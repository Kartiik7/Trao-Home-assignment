# ─── Server Environment Variables ───

# Port the Express server listens on
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ai-interview-prep

# Node environment (development | production | test)
NODE_ENV=development

# Secret key for signing JWTs (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Client URL for CORS origin (must match the Next.js dev server)
CLIENT_URL=http://localhost:3000

# ─── AI / LLM ───

# Groq API key — obtain one free at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Groq model ID to use for all LLM calls.
# openai/gpt-oss-20b is a capable default available on Groq's OpenAI-compatible endpoint.
# Other options: llama-3.1-8b-instant, llama3-70b-8192 — check availability at console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

# ─── Web Search / Retrieval ───

# Serper.dev API key — obtain a free key at https://serper.dev
# Used by the company-research step to fetch live web results before generating the company brief.
SERPER_API_KEY=your-serper-api-key-here
